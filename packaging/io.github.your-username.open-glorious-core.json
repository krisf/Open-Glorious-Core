{
  "app-id": "io.github.your-username.open-glorious-core",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.8",
  "sdk": "org.kde.Sdk",
  "command": "open-glorious-core",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=all",
    "--filesystem=xdg-run/udev:ro",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "modules": [
    {
      "name": "open-glorious-core",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-deps --prefix=/app .",
        "install -Dm644 packaging/open-glorious-core.desktop.in /app/share/applications/io.github.your-username.open-glorious-core.desktop",
        "sed -i -e 's|__APP_EXEC__|open-glorious-core|g' -e 's|__ICON_NAME__|io.github.your-username.open-glorious-core|g' /app/share/applications/io.github.your-username.open-glorious-core.desktop",
        "install -Dm644 src/open_glorious_core/static/assets/glorious-logomark.svg /app/share/icons/hicolor/scalable/apps/io.github.your-username.open-glorious-core.svg",
        "install -Dm644 99-open-glorious-core-hid.rules /app/share/open-glorious-core/99-open-glorious-core-hid.rules"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".."
        }
      ]
    }
  ]
}
