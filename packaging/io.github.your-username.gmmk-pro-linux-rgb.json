{
  "app-id": "io.github.your-username.gmmk-pro-linux-rgb",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.8",
  "sdk": "org.kde.Sdk",
  "command": "gmmk-rgb",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=all",
    "--filesystem=xdg-run/udev:ro",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "modules": [
    {
      "name": "gmmk-pro-linux-rgb",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-deps --prefix=/app .",
        "install -Dm644 packaging/gmmk-rgb.desktop.in /app/share/applications/io.github.your-username.gmmk-pro-linux-rgb.desktop",
        "sed -i -e 's|__APP_EXEC__|gmmk-rgb|g' -e 's|__ICON_NAME__|io.github.your-username.gmmk-pro-linux-rgb|g' /app/share/applications/io.github.your-username.gmmk-pro-linux-rgb.desktop",
        "install -Dm644 src/gmmk_rgb_app/static/assets/glorious-logomark.svg /app/share/icons/hicolor/scalable/apps/io.github.your-username.gmmk-pro-linux-rgb.svg",
        "install -Dm644 99-gmmk-pro-qmk-hid.rules /app/share/gmmk-pro-linux-rgb/99-gmmk-pro-qmk-hid.rules"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".."
        }
      ]
    }
  ]
}
